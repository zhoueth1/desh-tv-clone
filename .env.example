# Supabase Connect -> Session pooler. Fill in the real URI and URL-encoded password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@SESSION_POOLER_HOST:5432/postgres?sslmode=verify-full&sslrootcert=certs/supabase-prod-ca-2021.crt"
# Optional: only set this to a reachable migration connection for the SAME project.
# DIRECT_URL="postgresql://..."

NEXT_PUBLIC_HOST_URL="http://localhost:3000"
BASE_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-secret"
# Compatibility: NEXT_AUTH_SECRET is also recognized.

# Optional overrides for the existing dashboard credentials.
# ADMIN_USERNAME="admin"
# ADMIN_PASSWORD="password"

# Supabase web SDK configuration (not a substitute for DATABASE_URL).
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# Optional source connection for the legacy transfer buttons.
# OLD_DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"
